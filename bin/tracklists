#!/usr/bin/env ruby

# Writes tracks.yml from the show's play archive.
#
#   bin/tracklists [path/to/generation-zzz.sqlite3]
#
# The archive is built and kept up to date by the zzz gem
# (https://github.com/markryall/zzz) - `zzz_archive` scrapes every episode's
# Amrap playlist into sqlite, and `zzz_enrich` fills in what the 4zzz library
# knows about each track. This script only reads it, and only needs the
# sqlite3 command line tool, so the site itself stays dependency free.
#
# Episodes are keyed by number rather than date, matching episodes.yml:
# the show has gone out every Friday since 2022-06-03 without a gap, so the
# number is derived from the air date the same way bin/generate derives the
# date from the number.

require 'date'
require 'json'
require 'yaml'

START_DATE = Date.iso8601('2022-06-03')
ARCHIVE = ARGV[0] || File.expand_path('~/code/github/markryall/zzz/tmp/generation-zzz.sqlite3')

abort "no archive at #{ARCHIVE}" unless File.exist?(ARCHIVE)

QUERY = <<~SQL
  SELECT e.aired_on, p.position, p.artist, p.title,
         r.is_local, r.is_australian, r.is_first_nations,
         r.is_female, r.is_gender_diverse
  FROM plays p
  JOIN episodes e ON e.id = p.episode_id
  LEFT JOIN tracks t ON t.artist_key = lower(trim(p.artist))
                    AND t.title_key = lower(trim(p.title))
  LEFT JOIN releases r ON r.library_no = t.library_no
  ORDER BY e.aired_on, p.position
SQL

# the flags are what 4zzz records against the release, and they are what the
# station counts for its content quotas. a missing flag means we could not
# find the release, not that the answer is no - so nothing is shown for it.
TAGS = { 'is_local' => 'local', 'is_first_nations' => 'first nations',
         'is_female' => 'female', 'is_gender_diverse' => 'gender diverse',
         'is_australian' => 'australian' }.freeze

raw = `sqlite3 -json "file:#{ARCHIVE}?mode=ro" #{QUERY.gsub("\n", ' ').inspect}`
abort 'sqlite3 failed' unless $?.success?

episodes = Hash.new { |hash, key| hash[key] = [] }
JSON.parse(raw).each do |row|
  number = ((Date.iso8601(row['aired_on']) - START_DATE) / 7).to_i + 1
  tags = TAGS.filter_map { |column, tag| tag if row[column].to_i == 1 }
  # local already says australian, and saying both on every local track
  # buries the tags that are actually telling you something
  tags -= ['australian'] if tags.include?('local')
  track = { 'artist' => row['artist'].strip, 'title' => row['title'].strip }
  track['tags'] = tags unless tags.empty?
  episodes[number] << track
end

File.write('tracks.yml', episodes.sort.to_h.to_yaml)
puts "tracks.yml: #{episodes.length} episodes, #{episodes.values.sum(&:length)} tracks"
