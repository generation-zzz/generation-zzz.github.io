#!/usr/bin/env ruby

# Builds the whole site from two data files:
#
#   episodes.yml - one description per episode, in order. Position is the
#                  episode number, and the air date follows from it: the show
#                  has gone out every Friday since 2022-06-03 without a gap.
#   tracks.yml   - what was played, keyed by episode number. Written by
#                  bin/export out of the show's play archive. Optional -
#                  an episode with no entry just renders without a list.
#   guests.yml   - who was interviewed, and which episodes they were on. The
#                  name is wrapped in ** so it can be picked out of the prose.
#   playable.yml - the episodes 4ZZZ is still serving audio for. Written by
#                  bin/playable. Absent means none: the licence only covers
#                  streaming for a couple of months, so a player must never
#                  appear on an episode that has dropped off.
#
# Seasons are blocks of thirteen episodes. That is stated once, in SEASON_SIZE
# and season_of, because it used to be worked out two different ways: episode
# pages said (number / 13) + 1 while season pages used each_slice(13), so
# every thirteenth episode claimed a season it was not listed in.

require 'cgi'
require 'date'
require 'yaml'

START_DATE = Date.iso8601('2022-06-03')
SEASON_SIZE = 13
ANALYTICS_ID = 'G-9T560F91PF'
TAGLINE = 'Weekly radio show on Zed Digital, the digital station of 4ZZZ in Meanjin'

def season_of(number) = ((number - 1) / SEASON_SIZE) + 1
def date_of(number) = START_DATE + ((number - 1) * 7)
def folder_of(number) = format('e%03d', number)
def season_folder(number) = format('s%03d', number)
def h(text) = CGI.escapeHTML(text.to_s)
def pretty(date) = date.strftime('%-d %B %Y')

# The same song goes into the playlist spelled differently week to week, so
# the charts count a folded form of the artist and title: "Hate Crimes (at
# Paramount)", "... (Single)" and "... (at paramount)" are one song played
# eleven times. This is the zzz gem's Matcher.fold, repeated rather than
# shared because this repository builds on its own from a clone.
def fold(text)
  text.to_s.downcase
      .gsub(/\s*\((single|ep|deluxe|remaster(ed)?|live|explicit)[^)]*\)/, '')
      .gsub(/\s+(feat\.?|ft\.?|featuring|with)\s+.*\z/, '')
      .gsub(/['\u2018\u2019`]/, '')
      .gsub(/\s*&\s*/, ' and ')
      .gsub(/[^a-z0-9]+/, ' ')
      .strip
      .sub(/\Athe /, '')
end

# tracks.yml drops "australian" from a track already marked local, because
# saying both on every local track buries the tags that tell you something -
# so local has to be counted back in here
def has?(track, tag)
  tags = track['tags'] || []
  tags.include?(tag) || (tag == 'australian' && tags.include?('local'))
end

def write(path, contents)
  dir = File.dirname(path)
  Dir.mkdir(dir) unless dir == '.' || Dir.exist?(dir)
  File.write(path, contents)
end

# every page is the same shell - the only differences are what it is called,
# what a link preview should say about it, and what is inside it
def page(title:, description:, body:, heading:)
  <<~HTML
    <!DOCTYPE html>
    <html lang="en-AU">
        <head>
            <script async src="https://www.googletagmanager.com/gtag/js?id=#{ANALYTICS_ID}"></script>
            <script>
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '#{ANALYTICS_ID}');
            </script>
            <meta charset="UTF-8">
            <meta content="dark light" name="color-scheme">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <meta name="description" content="#{h(description)}">
            <meta property="og:title" content="#{h(title)}">
            <meta property="og:description" content="#{h(description)}">
            <meta property="og:image" content="/logo.jpeg">
            <meta property="og:type" content="website">
            <title>#{h(title)}</title>
            <link rel="icon" href="/favicon.ico">
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@600&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
            <link rel="stylesheet" type="text/css" href="/styles.css">
        </head>
        <body>
            <header class="masthead">
                <a class="brand" href="/">
                    <img src="/logo.jpeg" alt="" width="56" height="56">
                    <span>Generation ZZZ</span>
                </a>
            </header>
            <main>
    #{heading}
    #{body}
            </main>
            <footer>
                <p>Generation ZZZ is broadcast Fridays at 7pm on
                   <a href="https://4zzz.org.au/grid/ZD">Zed Digital</a>, the digital station of
                   <a href="https://4zzz.org.au">4ZZZ</a>, Meanjin.</p>
            </footer>
        </body>
    </html>
  HTML
end

def tracklist(entries)
  return '' if entries.nil? || entries.empty?

  items = entries.map do |track|
    tags = (track['tags'] || []).map do |tag|
      %(<span class="tag tag-#{tag.tr(' ', '-')}">#{h(tag)}</span>)
    end
    tagged = tags.empty? ? '' : %(<span class="tags">#{tags.join}</span>)
    <<~HTML
      <li>
          <span class="track">
              <span class="track-artist">#{h(track['artist'])}</span>
              <span class="track-title">#{h(track['title'])}</span>
          </span>
          #{tagged}
      </li>
    HTML
  end

  <<~HTML
    <section class="tracklist">
        <h2>What we played <span class="count">#{entries.length} tracks</span></h2>
        <ol>
    #{items.join}
        </ol>
    </section>
  HTML
end

episodes = YAML.load_file('episodes.yml')
tracks = File.exist?('tracks.yml') ? YAML.load_file('tracks.yml') : {}
playable = File.exist?('playable.yml') ? Array(YAML.load_file('playable.yml')) : []

# ---------------------------------------------------------------- episodes

episodes.each_with_index do |description, index|
  number = index + 1
  season = season_of(number)
  date = date_of(number)

  previous_link = number > 1 ? %(<a class="prev" href="/#{folder_of(number - 1)}">Episode #{number - 1}</a>) : ''
  next_link = number < episodes.length ? %(<a class="next" href="/#{folder_of(number + 1)}">Episode #{number + 1}</a>) : ''

  heading = <<~HTML
    <p class="crumbs"><a href="/#{season_folder(season)}">Season #{season}</a></p>
    <h1>Episode #{number}</h1>
    <p class="dateline"><time datetime="#{date}">#{pretty(date)}</time></p>
  HTML

  # 4ZZZ's licence only covers streaming an episode for a couple of months,
  # and Zed Digital stops serving it after that, so an older episode gets no
  # player rather than a broken one
  listen = if playable.include?(number)
             %(<audio controls preload="none" src="https://undead.4zzz.fm/zed-digital/ZD-#{date}-19-00.mp3"></audio>)
           else
             %(<p class="unavailable">4ZZZ can only stream an episode for a couple of months, so this one is no longer available to play.</p>)
           end

  body = <<~HTML
    <p class="blurb">#{h(description)}</p>
    <div class="listen">
        #{listen}
        <p><a href="https://4zzz.org.au/program/generation-zzz/#{date}%2019:00:00">Track information on 4ZZZ</a></p>
    </div>
    #{tracklist(tracks[number])}
    <nav class="pager">#{previous_link}#{next_link}</nav>
  HTML

  write("#{folder_of(number)}/index.html",
        page(title: "Generation ZZZ - Season #{season} - Episode #{number} - #{date}",
             description: description, heading: heading, body: body))
end

# ----------------------------------------------------------------- seasons

seasons = episodes.each_slice(SEASON_SIZE).to_a

seasons.each_with_index do |season_episodes, season_index|
  season = season_index + 1
  first = season_index * SEASON_SIZE + 1
  last = first + season_episodes.length - 1

  cards = (first..last).to_a.reverse.map do |number|
    played = tracks[number]
    <<~HTML
      <a class="card" href="/#{folder_of(number)}">
          <article>
              <h2>Episode #{number}</h2>
              <p class="dateline"><time datetime="#{date_of(number)}">#{pretty(date_of(number))}</time></p>
              <p>#{h(episodes[number - 1])}</p>
              #{played ? %(<p class="meta">#{played.length} tracks</p>) : ''}
          </article>
      </a>
    HTML
  end

  heading = <<~HTML
    <p class="crumbs"><a href="/">All seasons</a></p>
    <h1>Season #{season}</h1>
    <p class="dateline">#{pretty(date_of(first))} to #{pretty(date_of(last))}</p>
  HTML

  write("#{season_folder(season)}/index.html",
        page(title: "Generation ZZZ Season #{season}",
             description: "Episodes #{first} to #{last} of Generation ZZZ, " \
                          "#{pretty(date_of(first))} to #{pretty(date_of(last))}.",
             heading: heading,
             body: %(<section class="cards">\n#{cards.join}</section>)))
end

# ------------------------------------------------------------------ guests

guests = File.exist?('guests.yml') ? YAML.load_file('guests.yml') : {}

unless guests.empty?
  # the name is wrapped in ** inside the phrase, so it can be picked out
  # while keeping the words around it - "Meanjin punk band PRINK" reads
  # better on a page than "PRINK" alone, but it is PRINK you are looking for
  entries = guests.map do |phrase, numbers|
    before, name, after = phrase.split('**', 3)
    name, after = [before, ''] if name.nil?
    [name.to_s, before.to_s, after.to_s, Array(numbers).sort]
  end.sort_by { |name, _, _, _| name.downcase }

  items = entries.map do |name, before, after, numbers|
    links = numbers.map do |number|
      %(<a href="/#{folder_of(number)}">#{number}<span class="ep-date">#{date_of(number).strftime('%b %Y')}</span></a>)
    end
    <<~HTML
      <li>
          <span class="guest">#{h(before)}<strong>#{h(name)}</strong>#{h(after)}</span>
          <span class="guest-episodes">#{links.join}</span>
      </li>
    HTML
  end

  returning = entries.count { |_, _, _, numbers| numbers.length > 1 }
  body = <<~HTML
    <p class="lede">Everyone who has come on the show for a chat, and the episodes they were on.</p>
    <section class="guests"><ul>#{items.join}</ul></section>
    <p class="footnote">#{entries.length} guests across #{entries.sum { |_, _, _, n| n.length }} episodes#{returning.positive? ? ", #{returning} of them more than once" : ''}.</p>
  HTML

  write('guests/index.html',
        page(title: 'Generation ZZZ - guests',
             description: "Everyone interviewed on Generation ZZZ - #{entries.length} guests across #{entries.sum { |_, _, _, n| n.length }} episodes.",
             heading: %(<p class="crumbs"><a href="/">Home</a></p>\n<h1>Guests</h1>),
             body: body))
end

# ------------------------------------------------------------------- stats

FLAGS = [%w[australian Australian], %w[local Local], %w[female Female],
         ['gender diverse', 'Gender diverse'], ['first nations', 'First Nations']].freeze

all_played = tracks.flat_map { |number, played| played.map { |t| t.merge('episode' => number) } }

def meter(label, count, total, slug)
  share = total.zero? ? 0 : 100.0 * count / total
  <<~HTML
    <div class="meter">
        <div class="meter-label">#{h(label)}</div>
        <div class="meter-track"><div class="meter-fill meter-#{slug}" style="width: #{share.round(1)}%"></div></div>
        <div class="meter-value">#{format('%.1f%%', share)}</div>
    </div>
  HTML
end

def leaderboard(rows, heading, total_label)
  highest = rows.first&.last.to_i
  items = rows.each_with_index.map do |(label, count), index|
    width = highest.zero? ? 0 : 100.0 * count / highest
    <<~HTML
      <li>
          <span class="rank">#{index + 1}</span>
          <span class="leader-bar" style="width: #{width.round(1)}%"></span>
          <span class="leader-label">#{label}</span>
          <span class="leader-count">#{count}</span>
      </li>
    HTML
  end
  %(<section class="leaderboard"><h2>#{h(heading)} <span class="count">#{total_label}</span></h2>\n) +
    %(<ol>\n#{items.join}</ol></section>\n)
end

# counted on the folded form, and shown under whichever spelling was used most
def chart_of(played, limit)
  played.group_by { |track| yield(track) }.map do |_, group|
    label = group.group_by { |t| yield(t, :label) }.max_by { |_, g| g.length }.first
    [label, group.length]
  end.sort_by { |label, count| [-count, label.downcase] }.first(limit)
end

total = all_played.length
by_year = all_played.group_by { |track| date_of(track['episode']).year }

quota_rows = FLAGS.map do |tag, label|
  meter(label, all_played.count { |track| has?(track, tag) }, total, tag.tr(' ', '-'))
end

year_rows = by_year.keys.sort.map do |year|
  played = by_year[year]
  cells = FLAGS.map do |tag, _|
    share = 100.0 * played.count { |track| has?(track, tag) } / played.length
    %(<td>#{format('%.0f%%', share)}</td>)
  end
  %(<tr><th scope="row">#{year}</th><td class="muted">#{played.length}</td>#{cells.join}</tr>)
end

top_tracks = chart_of(all_played, 20) { |t, mode| mode ? "#{h(t['artist'])} <span class=\"sep\">·</span> #{h(t['title'])}" : [fold(t['artist']), fold(t['title'])] }
top_artists = chart_of(all_played, 20) { |t, mode| mode ? h(t['artist']) : fold(t['artist']) }

songs = all_played.map { |t| [fold(t['artist']), fold(t['title'])] }.uniq.length
artists = all_played.map { |t| fold(t['artist']) }.uniq.length
tagged = all_played.count { |t| t['tags'] }

stats_body = <<~HTML
  <p class="lede">Every song Generation ZZZ has played since #{pretty(date_of(1))}, counted up.</p>
  <section class="tally">
      <div><strong>#{episodes.length}</strong><span>episodes</span></div>
      <div><strong>#{total}</strong><span>songs played</span></div>
      <div><strong>#{songs}</strong><span>different songs</span></div>
      <div><strong>#{artists}</strong><span>different artists</span></div>
  </section>

  <section>
      <h2>The 4ZZZ content quotas</h2>
      #{quota_rows.join}
      <p class="footnote">4ZZZ counts female and gender diverse as a single quota, which comes to
         #{format('%.1f%%', 100.0 * all_played.count { |t| has?(t, 'female') || has?(t, 'gender diverse') } / total)}.
         Of #{total} songs, #{tagged} carry at least one of these. A song with none is one whose release
         we could not identify in the 4ZZZ library - not one where the answer is no, so these are floors
         rather than exact counts.</p>
  </section>

  <section>
      <h2>Year by year</h2>
      <div class="scroller">
      <table class="years">
          <thead><tr><th scope="col">Year</th><th scope="col">Songs</th>#{FLAGS.map { |_, l| "<th scope=\"col\">#{l}</th>" }.join}</tr></thead>
          <tbody>#{year_rows.join}</tbody>
      </table>
      </div>
  </section>

  #{leaderboard(top_tracks, 'Most played songs', 'spellings folded together')}
  #{leaderboard(top_artists, 'Most played artists', "of #{artists}")}
HTML

write('stats/index.html',
      page(title: 'Generation ZZZ - the numbers',
           description: "#{episodes.length} episodes, #{total} songs played, and how they measure up to 4ZZZ's content quotas.",
           heading: %(<p class="crumbs"><a href="/">Home</a></p>\n<h1>The numbers</h1>),
           body: stats_body))

# ------------------------------------------------------------------- index

latest = episodes.length
season_cards = seasons.each_with_index.to_a.reverse.map do |_season_episodes, season_index|
  season = season_index + 1
  first = season_index * SEASON_SIZE + 1
  last = [first + SEASON_SIZE - 1, episodes.length].min
  <<~HTML
    <a class="card" href="/#{season_folder(season)}">
        <article>
            <h2>Season #{season}</h2>
            <p class="dateline">#{pretty(date_of(first))} to #{pretty(date_of(last))}</p>
            <p class="meta">Episodes #{first}&ndash;#{last}</p>
        </article>
    </a>
  HTML
end

intro = <<~HTML
  <p class="lede">Generation ZZZ is a weekly radio show on <a href="https://4zzz.org.au/grid/ZD">Zed
     Digital</a>, the digital station of Meanjin community radio station
     <a href="https://4zzz.org.au">4ZZZ</a>.</p>
  <p>Mark (the parent - he/him) and Lu (the kid - he/him) discuss the multigenerational
     experience of music and community radio.</p>
  <p class="latest"><a href="/#{folder_of(latest)}">Latest episode: #{latest}, #{pretty(date_of(latest))}</a>
     <span class="sep">·</span> <a href="/guests">Guests</a>
     <span class="sep">·</span> <a href="/stats">The numbers</a></p>
HTML

write('index.html',
      page(title: 'Generation ZZZ',
           description: TAGLINE,
           heading: %(<h1 class="home">Generation ZZZ</h1>),
           body: %(#{intro}<section class="cards" aria-label="Seasons">\n#{season_cards.join}</section>)))

puts "#{episodes.length} episodes, #{seasons.length} seasons, #{tracks.values.sum(&:length)} tracks listed"
