#!/usr/bin/env ruby

# Walks through a week of the show, from the running sheet to the page on this
# site, as a runbook (runbooks/episode.md) for chicken_and_egg's runner.
#
#   bin/episode [number]          step through whatever isn't done yet
#   bin/episode [number] --list   print the board, change nothing
#   bin/episode done <probe>      exit 0 when that part is done - the checks
#                                 the runbook asks, kept here so they can be
#                                 run on their own
#
# The episode defaults to this week's: the coming Friday, or the one just gone
# on a weekend, which is when the site gets caught up after the broadcast.
#
# Every step is checked against the episode rather than remembered, so the
# runner's own state - a note that a step with no check was done, or that one
# was declined with n - only means anything for one episode. Moving on to a
# new one clears it.

require 'date'
require 'fileutils'
require 'yaml'

START_DATE = Date.iso8601('2022-06-03')
SITE = File.expand_path('..', __dir__)
RUNBOOK = File.join(SITE, 'runbooks', 'episode.md')
STATE_DIR = File.expand_path('~/.local/state/runbook')
MARKER = File.join(STATE_DIR, 'episode-md.episode')

def date_of(number) = START_DATE + ((number - 1) * 7)
def number_on(date) = ((date - START_DATE) / 7).to_i + 1

def this_weeks
  today = Date.today
  friday = today.saturday? || today.sunday? ? today - ((today.wday - 5) % 7) : today + ((5 - today.wday) % 7)
  number_on(friday)
end

def settings = @settings ||= YAML.load_file(File.expand_path('~/.zzz'))
def show_db = File.expand_path("~/.zzz_db/#{settings.fetch('show')}.sqlite")
def episodes_dir = File.expand_path(settings.fetch('episodes_path'))

def environment(number)
  {
    'EPISODE' => number.to_s,
    'AIRED_ON' => date_of(number).iso8601,
    'ZZZ' => File.expand_path(ENV['ZZZ'] || '~/code/github/markryall/zzz'),
    'SHOW_DB' => show_db,
    'EPISODE_DIR' => File.join(episodes_dir, number.to_s)
  }
end

def query(sql)
  `sqlite3 "file:#{show_db}?mode=ro" #{sql.gsub("\n", ' ').inspect}`.strip
end

def count(sql) = query(sql).to_i

# the same joins bin/export uses to decide a track's tags, restricted to one
# broadcast
def plays_on(date, where)
  count(<<~SQL)
    SELECT count(*) FROM plays p
    JOIN episodes e ON e.id = p.episode_id
    LEFT JOIN tracks t ON t.artist_key = lower(trim(p.artist)) AND t.title_key = lower(trim(p.title))
    LEFT JOIN releases r ON r.library_no = t.library_no
    LEFT JOIN manual_artists m ON m.artist_key = lower(trim(p.artist))
    WHERE e.aired_on = '#{date}' AND #{where}
  SQL
end

def probe(name, number)
  env = environment(number)
  date = env['AIRED_ON']
  page = File.join(SITE, format('e%03d', number), 'index.html')

  case name
  when 'planned' then count("SELECT count(*) FROM show_segments WHERE episode = '#{number}'").positive?
  when 'prepared'
    count("SELECT count(*) FROM planned_plays WHERE episode = '#{number}'").positive? &&
      File.exist?(File.join(env['EPISODE_DIR'], "#{number}.RPP"))
  when 'rendered' then File.exist?(File.join(env['EPISODE_DIR'], "#{number}.mp3"))
  when 'mailed'
    mail = "from:#{settings.fetch('mail_from')} AND subject:\"#{settings.fetch('mail_subject')} #{number}\""
    !`mu find #{mail.inspect} --fields s 2>/dev/null`.strip.empty?
  when 'described'
    !query("SELECT description FROM show_plans WHERE episode = '#{number}'").empty?
  when 'aired' then Time.now >= Time.new(*date.split('-').map(&:to_i), 20)
  when 'archived' then plays_on(date, '1').positive?
  when 'enriched' then plays_on(date, '1').positive? && plays_on(date, 't.looked_up_at IS NULL').zero?
  when 'classified' then plays_on(date, '1').positive? && plays_on(date, 'r.library_no IS NULL AND m.artist_key IS NULL').zero?
  when 'exported'
    YAML.load_file(File.join(SITE, 'tracks.yml')).key?(number) &&
      YAML.load_file(File.join(SITE, 'episodes.yml')).length >= number
  when 'playable' then Array(YAML.load_file(File.join(SITE, 'playable.yml'))).include?(number)
  when 'built' then File.exist?(page) && File.read(page).include?('class="tracklist"')
  when 'pushed' then `git -C #{SITE} log origin/main --format=%s`.lines.map(&:strip).include?("episode #{number}")
  when 'live'
    domain = File.read(File.join(SITE, 'CNAME')).strip
    `curl -fsSL --max-time 20 https://#{domain}/#{format('e%03d', number)}/ 2>/dev/null`.include?('class="tracklist"')
  else abort "no probe called #{name}"
  end
end

if ARGV.first == 'done'
  name = ARGV[1] or abort 'usage: bin/episode done <probe>'
  number = (ENV['EPISODE'] || this_weeks).to_i
  exit probe(name, number) ? 0 : 1
end

number = (ARGV.find { |arg| arg.match?(/\A\d+\z/) } || this_weeks).to_i
flags = ARGV.select { |arg| arg.start_with?('--') }

runner = [ENV['RUNBOOK'], File.expand_path('~/.local/bin/runbook'),
          File.expand_path('~/code/github/markryall/chicken_and_egg/runbook.py')].compact.find { |path| File.executable?(path) }
abort 'no runbook runner - install chicken_and_egg, or point $RUNBOOK at runbook.py' unless runner

env = environment(number)

# the runner only substitutes variables into what it runs, so the prose and
# the by-hand steps would say "open $EPISODE_DIR/$EPISODE.RPP" as written.
# Fill them in on a copy - in tmp/ so it stays inside this checkout, which is
# where the runner runs the steps from.
rendered = File.join(SITE, 'tmp', File.basename(RUNBOOK))
FileUtils.mkdir_p(File.dirname(rendered))
names = env.keys.sort_by { |name| -name.length }.join('|')
File.write(rendered, File.read(RUNBOOK).gsub(/\$\{(#{names})\}|\$(#{names})\b/) { env[$1 || $2] })

if File.exist?(MARKER) ? File.read(MARKER).strip != number.to_s : true
  system(runner, rendered, '--reset', out: File::NULL)
  FileUtils.mkdir_p(STATE_DIR)
  File.write(MARKER, number.to_s)
end

puts "episode #{number}, on air #{date_of(number).strftime('%A %-d %B %Y')}"
exec(env, runner, rendered, *flags)
